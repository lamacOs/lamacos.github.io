            color: var(--color-primary);
            margin-bottom: var(--spacing-sm);
        }

        .stat-label {
            font-size: 0.875rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        @media (max-width: 640px) {
            body {
                font-size: 15px;
            }
        }
    </style>
</head>
