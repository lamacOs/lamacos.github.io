                            <select class="form-select" id="validationType">
                                <option value="command">Minecraft Command</option>
                                <option value="json">JSON</option>
                                <option value="snbt">SNBT</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Inhalt eingeben</label>
                            <textarea class="form-textarea" id="validatorInput" placeholder="Gib den zu validierenden Inhalt ein..."></textarea>
                        </div>

                        <button class="button button-primary w-full" id="validateBtn">✅ Validieren</button>
                    </div>

                    <div style="overflow-y: auto; -webkit-overflow-scrolling: touch;">
                        <h3 style="margin-bottom: var(--spacing-lg);">Ergebnis</h3>
                        <div id="validationResult" class="text-muted">Validierungsergebnisse werden hier angezeigt</div>
                    </div>
                </div>
            `;

            const validateBtn = container.querySelector('#validateBtn');
            const validationResult = container.querySelector('#validationResult');
            const validationType = container.querySelector('#validationType');
            const validatorInput = container.querySelector('#validatorInput');

            validateBtn.addEventListener('click', () => {
                const type = validationType.value;
                const content = validatorInput.value.trim();

                if (!content) {
                    validationResult.innerHTML = '<div class="alert alert-error"><div class="alert-icon">✕</div><div>Bitte gib einen Inhalt ein</div></div>';
                    return;
                }

                let errors = [];
                let warnings = [];

                if (type === 'json') {
                    try {
                        JSON.parse(content);
                        validationResult.innerHTML = '<div class="alert alert-success"><div class="alert-icon">✓</div><div>JSON ist gültig!</div></div>';
                    } catch (e) {
                        errors.push(e.message);
                    }
                } else if (type === 'command') {
                    if (!content.startsWith('/')) {
                        warnings.push('Command sollte mit "/" beginnen');
                    }
                    validationResult.innerHTML = `
                        <div class="alert alert-success"><div class="alert-icon">✓</div><div>Command sieht gültig aus</div></div>
                        ${warnings.length > 0 ? warnings.map(w => `<div class="alert alert-warning"><div class="alert-icon">⚠</div><div>${w}</div></div>`).join('') : ''}
                    `;
                } else if (type === 'snbt') {
                    if (content.includes('{') && content.includes('}')) {
                        validationResult.innerHTML = '<div class="alert alert-success"><div class="alert-icon">✓</div><div>SNBT Format ist gültig!</div></div>';
                    } else {
                        errors.push('SNBT muss geschweifte Klammern enthalten');
                    }
                }

                if (errors.length > 0) {
                    validationResult.innerHTML = errors.map(e => `<div class="alert alert-error"><div class="alert-icon">✕</div><div>${e}</div></div>`).join('');
                }
            });
        }

