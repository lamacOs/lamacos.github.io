        // ============================================================================
        // INITIALIZATION
        // ============================================================================

        function initApp() {
            initDarkMode();
            initEventListeners();
            loadProjects();
            renderSidebar();
            updateProjectList();
        }

        function initDarkMode() {
            if (app.darkMode) {
                document.body.classList.add('dark-mode');
                updateThemeToggle();
            }
        }

        function initEventListeners() {
            // Sidebar & Navigation
            document.getElementById('menuToggle').addEventListener('click', toggleSidebar);
            document.getElementById('darkModeToggle').addEventListener('click', toggleDarkMode);

            // Search
            document.getElementById('searchInput').addEventListener('input', handleSearch);
            document.getElementById('homeSearchInput').addEventListener('input', handleHomeSearch);

            // Modals
            document.getElementById('newProjectBtn').addEventListener('click', () => openModal('newProjectModal'));
            document.getElementById('createProjectBtn').addEventListener('click', createProject);
            document.getElementById('importBtn').addEventListener('click', handleImport);
            document.getElementById('exportBtn').addEventListener('click', handleExport);

            // Modal close buttons
            document.querySelectorAll('[data-close-modal]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const modal = e.target.closest('.modal-overlay');
                    closeModal(modal.id);
                });
            });

            // Editor
            document.getElementById('backButton').addEventListener('click', goHome);
            document.getElementById('copyBtn').addEventListener('click', copyOutput);
            document.getElementById('saveBtn').addEventListener('click', saveProject);
            document.getElementById('undoBtn').addEventListener('click', undo);
            document.getElementById('redoBtn').addEventListener('click', redo);

            // Tool cards
            document.addEventListener('click', (e) => {
                const toolCard = e.target.closest('.tool-card');
                if (toolCard) {
                    const toolId = toolCard.dataset.toolId;
                    loadTool(toolId);
                }
            });

            // Keyboard shortcuts
            document.addEventListener('keydown', handleKeyboardShortcuts);

            // Close search on click outside
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.search-box')) {
                    document.getElementById('searchResults').classList.remove('visible');
                }
            });
        }

        function renderSidebar() {
            const sidebarNav = document.getElementById('sidebarNav');
            sidebarNav.innerHTML = '';

            const categories = [...new Set(Object.values(app.tools).map(t => t.category))];

            categories.forEach(category => {
                const section = document.createElement('div');
                section.className = 'nav-section';

                const title = document.createElement('div');
                title.className = 'nav-section-title';
                title.textContent = category;
                section.appendChild(title);

                Object.entries(app.tools).forEach(([id, tool]) => {
                    if (tool.category === category) {
                        const item = document.createElement('button');
                        item.className = 'nav-item';
                        item.innerHTML = `<span class="nav-item-icon">${tool.icon}</span><span>${tool.name}</span>`;
                        item.addEventListener('click', () => loadTool(id));
                        section.appendChild(item);
                    }
                });

                sidebarNav.appendChild(section);
            });
        }

        // ============================================================================
        // NAVIGATION & UI
        // ============================================================================

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
        }

        function toggleDarkMode() {
            app.darkMode = !app.darkMode;
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('darkMode', app.darkMode);
            updateThemeToggle();
        }

        function updateThemeToggle() {
            const btn = document.getElementById('darkModeToggle');
            btn.textContent = app.darkMode ? '☀️ Light Mode' : '🌙 Dark Mode';
        }

        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.classList.add('visible');
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal(modalId);
            });
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('visible');
        }

        function showNotification(message, type = 'info') {
            const container = document.getElementById('notificationContainer');
            const notification = document.createElement('div');
            notification.className = 'notification';

            const icons = {
                success: '✓',
                error: '✕',
                warning: '⚠',
                info: 'ℹ'
            };

            notification.innerHTML = `
                <span class="notification-icon">${icons[type]}</span>
                <span class="notification-message">${message}</span>
                <button class="notification-close">×</button>
            `;

            container.appendChild(notification);

            notification.querySelector('.notification-close').addEventListener('click', () => {
                notification.remove();
            });

            setTimeout(() => notification.remove(), 4000);
        }

        // ============================================================================
        // SEARCH & FILTER
        // ============================================================================

        function handleSearch(e) {
            const query = e.target.value.toLowerCase();
            const resultsContainer = document.getElementById('searchResults');

            if (!query.trim()) {
                resultsContainer.classList.remove('visible');
                return;
            }

            const results = Object.entries(app.tools).filter(([id, tool]) => {
                return tool.name.toLowerCase().includes(query) ||
                       tool.category.toLowerCase().includes(query) ||
                       tool.description.toLowerCase().includes(query);
            });

            if (results.length === 0) {
                resultsContainer.innerHTML = '<div style="padding: 1rem; text-align: center; color: var(--text-tertiary);">Keine Tools gefunden</div>';
                resultsContainer.classList.add('visible');
                return;
            }

            resultsContainer.innerHTML = results.map(([id, tool]) => `
                <div class="search-result-item" data-tool-id="${id}">
                    <div class="search-result-icon">${tool.icon}</div>
                    <div class="search-result-text">
                        <div class="search-result-title">${tool.name}</div>
                        <div class="search-result-category">${tool.category}</div>
                    </div>
                </div>
            `).join('');

            resultsContainer.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', () => {
                    loadTool(item.dataset.toolId);
                    resultsContainer.classList.remove('visible');
                    document.getElementById('searchInput').value = '';
                    closeSidebar();
                });
            });

            resultsContainer.classList.add('visible');
        }

        function handleHomeSearch(e) {
            const query = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.tool-card');

            cards.forEach(card => {
                const title = card.querySelector('.tool-card-title').textContent.toLowerCase();
                const description = card.querySelector('.tool-card-description').textContent.toLowerCase();
                const matches = title.includes(query) || description.includes(query);
                card.style.display = matches ? '' : 'none';
            });
        }

        // ============================================================================
        // TOOL SYSTEM
        // ============================================================================

        function loadTool(toolId) {
            if (!app.tools[toolId]) return;

            app.currentTool = toolId;
            closeSidebar();

            // Hide home, show editor
            document.getElementById('homePage').classList.add('hidden');
            document.getElementById('editorContainer').classList.remove('hidden');

            // Render tool content
            const editorContent = document.getElementById('editorContent');
            editorContent.innerHTML = '';
            app.tools[toolId].render(editorContent);

            // Reset history for new tool
            app.history = [];
            app.historyIndex = -1;
        }

        function goHome() {
            app.currentTool = null;
            document.getElementById('homePage').classList.remove('hidden');
            document.getElementById('editorContainer').classList.add('hidden');
            closeSidebar();
        }

        function addHistory(state) {
            app.history = app.history.slice(0, app.historyIndex + 1);
            app.history.push(state);
            app.historyIndex++;
        }

        function undo() {
            if (app.historyIndex > 0) {
                app.historyIndex--;
                restoreHistory(app.history[app.historyIndex]);
            }
        }

        function redo() {
            if (app.historyIndex < app.history.length - 1) {
                app.historyIndex++;
                restoreHistory(app.history[app.historyIndex]);
            }
        }

        function restoreHistory(state) {
            console.log('Restoring state:', state);
        }

        // ============================================================================
        // PROJECT MANAGEMENT
        // ============================================================================

        function createProject() {
            const name = document.getElementById('projectNameInput').value.trim();
            const description = document.getElementById('projectDescInput').value.trim();

            if (!name) {
                showNotification('Projektname ist erforderlich', 'error');
                return;
            }

            const project = {
                id: Date.now(),
                name,
                description,
                created: new Date(),
                modified: new Date(),
                data: {}
            };

            app.projects.push(project);
            saveProjects();
            updateProjectList();
            closeModal('newProjectModal');
            showNotification(`Projekt "${name}" erstellt`, 'success');

            // Clear inputs
            document.getElementById('projectNameInput').value = '';
            document.getElementById('projectDescInput').value = '';
        }

        function deleteProject(id) {
            if (confirm('Wirklich löschen?')) {
                app.projects = app.projects.filter(p => p.id !== id);
                saveProjects();
                updateProjectList();
                showNotification('Projekt gelöscht', 'success');
            }
        }

        function loadProject(id) {
            app.currentProject = app.projects.find(p => p.id === id);
            if (app.currentProject) {
                showNotification(`Projekt "${app.currentProject.name}" geladen`, 'success');
            }
        }

        function saveProject() {
            if (!app.currentProject) {
                showNotification('Kein Projekt geladen', 'error');
                return;
            }

            app.currentProject.modified = new Date();
            saveProjects();
            showNotification('Projekt gespeichert', 'success');
        }

        function saveProjects() {
            localStorage.setItem('lamatools_projects', JSON.stringify(app.projects));
        }

        function loadProjects() {
            const saved = localStorage.getItem('lamatools_projects');
            if (saved) {
                try {
                    app.projects = JSON.parse(saved);
                } catch (e) {
                    console.error('Error loading projects:', e);
                }
            }
        }

        function updateProjectList() {
            const projectList = document.getElementById('projectList');

            if (app.projects.length === 0) {
                projectList.innerHTML = `
                    <div class="text-center" style="grid-column: 1/-1; color: var(--text-tertiary); padding: var(--spacing-2xl);">
                        Keine Projekte vorhanden. Erstelle ein neues Projekt, um zu beginnen.
                    </div>
                `;
                return;
            }

            projectList.innerHTML = app.projects.map(project => `
                <div class="project-item">
                    <div class="project-name">${project.name}</div>
                    ${project.description ? `<div class="text-sm text-muted">${project.description}</div>` : ''}
                    <div class="project-info">
                        <span>Erstellt: ${new Date(project.created).toLocaleDateString('de-DE')}</span>
                        <span>Geändert: ${new Date(project.modified).toLocaleDateString('de-DE')}</span>
                    </div>
                    <div class="project-actions">
                        <button class="button button-secondary button-small" data-load-project="${project.id}">Öffnen</button>
                        <button class="button button-secondary button-small" data-export-project="${project.id}">Exportieren</button>
                        <button class="button button-secondary button-small" data-delete-project="${project.id}">Löschen</button>
                    </div>
                </div>
            `).join('');

            // Add event listeners
            document.querySelectorAll('[data-load-project]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    loadProject(parseInt(e.target.dataset.loadProject));
                });
            });

            document.querySelectorAll('[data-delete-project]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    deleteProject(parseInt(e.target.dataset.deleteProject));
                });
            });

            document.querySelectorAll('[data-export-project]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    exportProject(parseInt(e.target.dataset.exportProject));
                });
            });
        }

        function exportProject(id) {
            const project = app.projects.find(p => p.id === id);
            if (!project) return;

            const json = JSON.stringify(project, null, 2);
            const blob = new Blob([json], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${project.name.replace(/\s+/g, '_')}.lamatools.json`;
            a.click();
            URL.revokeObjectURL(url);
            showNotification('Projekt exportiert', 'success');
        }

        // ============================================================================
        // IMPORT/EXPORT
        // ============================================================================

        function handleImport() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json,.lamatools';
            input.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const data = JSON.parse(event.target.result);
                        if (data.id && data.name) {
                            app.projects.push(data);
                            saveProjects();
                            updateProjectList();
                            showNotification('Projekt importiert', 'success');
                        } else {
                            showNotification('Ungültiges Projektformat', 'error');
                        }
                    } catch (err) {
                        showNotification('Fehler beim Importieren: ' + err.message, 'error');
                    }
                };
                reader.readAsText(file);
            });
            input.click();
        }

        function handleExport() {
            const json = JSON.stringify({
                version: '1.0',
                projects: app.projects,
                exported: new Date()
            }, null, 2);
            const blob = new Blob([json], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `lamatools_backup_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showNotification('Sicherung erstellt', 'success');
        }

        function copyOutput() {
            const output = document.querySelector('.command-preview') || 
                          document.querySelector('.code-output') ||
                          document.querySelector('[data-output]');

            if (!output) {
                showNotification('Keine Ausgabe zum Kopieren', 'warning');
                return;
            }

            const text = output.textContent || output.value;
            navigator.clipboard.writeText(text).then(() => {
                showNotification('Kopiert!', 'success');
            }).catch(() => {
                showNotification('Fehler beim Kopieren', 'error');
            });
        }

        // ============================================================================
        // KEYBOARD SHORTCUTS
        // ============================================================================

        function handleKeyboardShortcuts(e) {
            const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
            const ctrl = isMac ? e.metaKey : e.ctrlKey;

            if (ctrl && e.key === 's') {
                e.preventDefault();
                saveProject();
            } else if (ctrl && e.key === 'z' && !e.shiftKey) {
                e.preventDefault();
                undo();
            } else if ((ctrl && e.key === 'z' && e.shiftKey) || (ctrl && e.key === 'y')) {
                e.preventDefault();
                redo();
            } else if (ctrl && e.key === 'c') {
                // Use default copy behavior
            } else if (e.key === 'Escape') {
                closeAllModals();
                closeSidebar();
            }
        }

        function closeAllModals() {
            document.querySelectorAll('.modal-overlay.visible').forEach(modal => {
                modal.classList.remove('visible');
            });
        }

