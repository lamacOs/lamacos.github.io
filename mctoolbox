            opacity: 0.6;
            font-size: 1.25rem;
            flex-shrink: 0;
            margin-top: 0.25rem;
        }

        .builder-block-drag:active {
            cursor: grabbing;
        }

        .builder-block-content {
            flex: 1;
            min-width: 0;
        }

        .builder-block-remove {
            flex-shrink: 0;
        }

        /* PROJECT LIST */
        .project-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: var(--spacing-lg);
            margin-top: var(--spacing-lg);
        }

        @media (max-width: 768px) {
            .project-list {
                grid-template-columns: 1fr;
            }
        }

        .project-item {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
            transition: all var(--transition-normal);
            cursor: pointer;
        }

        .project-item:hover {
            border-color: var(--color-primary);
            box-shadow: var(--shadow-md);
        }

        .project-name {
            font-weight: 600;
            font-size: 1rem;
        }

        .project-info {
            font-size: 0.875rem;
            color: var(--text-tertiary);
            display: flex;
            gap: var(--spacing-md);
        }

        .project-actions {
            display: flex;
            gap: var(--spacing-sm);
            margin-top: auto;
        }

        /* CANVAS EDITOR (for HUD, GUI) */
        .canvas-container {
            position: relative;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, var(--bg-secondary) 25%, transparent 25%, transparent 75%, var(--bg-secondary) 75%, var(--bg-secondary)),
                        linear-gradient(45deg, var(--bg-secondary) 25%, transparent 25%, transparent 75%, var(--bg-secondary) 75%, var(--bg-secondary));
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
            border-radius: var(--border-radius);
            overflow: auto;
            -webkit-overflow-scrolling: touch;
        }

        .canvas-element {
            position: absolute;
            background-color: var(--bg-primary);
            border: 2px solid var(--border-color);
            border-radius: var(--border-radius);
            padding: var(--spacing-sm);
            cursor: move;
            user-select: none;
            min-width: 50px;
            min-height: 30px;
            transition: border-color var(--transition-fast);
        }

        .canvas-element.selected {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.2);
        }

        .canvas-element-resize {
            position: absolute;
            width: 8px;
            height: 8px;
            background-color: var(--color-primary);
            border-radius: 2px;
            right: -4px;
            bottom: -4px;
            cursor: se-resize;
            opacity: 0;
            transition: opacity var(--transition-fast);
        }

        .canvas-element:hover .canvas-element-resize {
            opacity: 1;
        }

        /* SPECIFIC TOOL STYLES */
        .color-picker-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
            gap: var(--spacing-sm);
        }

        .color-swatch {
            width: 100%;
            aspect-ratio: 1;
            border-radius: var(--border-radius);
            border: 2px solid var(--border-color);
            cursor: pointer;
            transition: transform var(--transition-fast);
        }

        .color-swatch:hover {
            transform: scale(1.1);
        }

        .color-swatch.selected {
            border-color: var(--text-primary);
            box-shadow: 0 0 0 2px var(--bg-primary), 0 0 0 4px var(--text-primary);
        }

        /* NOTIFICATIONS */
        .notification-container {
            position: fixed;
            bottom: var(--spacing-lg);
            right: var(--spacing-lg);
            z-index: 600;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }

        @media (max-width: 640px) {
            .notification-container {
                left: var(--spacing-md);
                right: var(--spacing-md);
                max-width: none;
            }
        }

        .notification {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            padding: var(--spacing-md);
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            box-shadow: var(--shadow-lg);
            animation: slideUp var(--transition-normal) ease-out;
        }

        .notification-icon {
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .notification-message {
            flex: 1;
            font-size: 0.875rem;
        }

        .notification-close {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.25rem;
            color: var(--text-tertiary);
            flex-shrink: 0;
            padding: 0;
            width: 1.5rem;
            height: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* COMMAND PREVIEW */
        .command-preview {
            background-color: var(--bg-tertiary);
            border-left: 3px solid var(--color-primary);
            border-radius: 0 var(--border-radius) var(--border-radius) 0;
            padding: var(--spacing-md);
            font-family: 'Courier New', monospace;
            font-size: 0.85rem;
            word-break: break-all;
            line-height: 1.5;
            position: relative;
            max-height: 200px;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* STATISTICS */
        .stat-box {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            text-align: center;
        }

        .stat-value {
            font-size: clamp(1.5rem, 4vw, 2rem);
